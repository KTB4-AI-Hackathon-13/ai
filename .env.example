# LLM 프로바이더 — Gemini(최종 배포용) → Cerebras → Groq 순으로 시도한다.
# app/plan_generation/providers.py 참고.
#
# 해커톤 개발 기간에는 아래 GEMINI_API_KEY를 비워두고 Cerebras/Groq로 실사용하다가,
# 제출 직전에 GEMINI_API_KEY만 채우면 자동으로 Gemini가 쓰인다.

# 최종 배포용. 비어 있으면 자동으로 Cerebras로 스킵된다.
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.5-flash-lite

# 해커톤 기간 중 기본으로 쓰는 키(Gemini 없을 때 1차).
CEREBRAS_API_KEY=your-cerebras-key
CEREBRAS_MODEL=gemma-4-31b

# Gemini/Cerebras 둘 다 없을 때 쓰는 마지막 폴백.
GROQ_API_KEY=your-groq-key
GROQ_MODEL=openai/gpt-oss-20b

# BE 서버 주소 — 대화 기록/최종 계획을 이쪽으로 전송한다(app/plan_generation/be_client.py).
# 비워두면 해당 전송을 건너뛴다(로컬 단독 테스트용).
BE_BASE_URL=
